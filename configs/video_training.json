{
  "version": 1,
  "paths": {
    "video_root": "vid_dataset",
    "dataset_root": "dataset/rebuilt_video",
    "models_root": "models",
    "results_root": "results"
  },
  "preprocessing": {
    "sampling_fps": 2.0,
    "image_size": 224,
    "clip_frames": 8,
    "sequence_seconds": 8.0,
    "max_frames_per_video": 240,
    "max_sequences_per_video": 40,
    "min_laplacian_variance": 5.0,
    "phash_duplicate_distance": 2,
    "accident_pre_seconds": 2.0,
    "accident_post_seconds": 2.0,
    "normal_window_seconds": 2.4,
    "normal_impact_margin_seconds": 2.0,
    "seed": 42
  },
  "splits": {
    "train": 0.70,
    "val": 0.15,
    "test": 0.15,
    "preserve_tad_official_test": true,
    "reviewed_traffic_split": "train"
  },
  "training": {
    "model": "mobilenet_v3_small_gru",
    "pretrained": true,
    "batch_size": 4,
    "epochs": 20,
    "patience": 5,
    "backbone_learning_rate": 0.00001,
    "head_learning_rate": 0.0003,
    "weight_decay": 0.0001,
    "num_workers": 2,
    "recall_target": 0.90,
    "class_to_idx": {
      "Non_Accident": 0,
      "Accident": 1
    }
  }
}
