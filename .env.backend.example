# Optional: set a long random value before exposing detector ingestion beyond localhost
SURAKSHAN_AUTH_SECRET=replace-with-a-long-random-secret
SURAKSHAN_DETECTOR_TOKEN=
SURAKSHAN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Change these demo passwords before any shared deployment
SURAKSHAN_ADMIN_PASSWORD=Admin@12345
SURAKSHAN_AUTHORITY_PASSWORD=Authority@12345
SURAKSHAN_HOSPITAL_PASSWORD=Hospital@12345
